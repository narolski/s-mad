+def write(path,obj):
+    """Durable create-only JSON; serialization failure cannot leave an empty claim."""
+    path=Path(path)
+    payload=(json.dumps(obj,indent=2,allow_nan=False)+'\n').encode('utf-8')
+    with path.open('xb') as f:
+        f.write(payload);f.flush();os.fsync(f.fileno())
+    fd=os.open(str(path.parent),os.O_RDONLY|getattr(os,'O_DIRECTORY',0))
+    try:os.fsync(fd)
+    finally:os.close(fd)
+
+
+def set_overlay_fill(c,ColorClass,rgb,alpha):
+    """ReportLab Color resets its alpha; explicit opacity MUST be applied afterwards."""
+    c.setFillColor(ColorClass(*rgb))
+    c.setFillAlpha(alpha)
 
 
