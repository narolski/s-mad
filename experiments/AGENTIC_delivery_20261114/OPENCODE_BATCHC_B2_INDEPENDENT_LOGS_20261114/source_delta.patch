+def _within_d_context(mock=False):
+    """Amendment 4b display only; no floor calculation or candidate access.
+
+    Verify both context files and their stage-6 pinfile against HEAD before
+    native access. Mock mode embeds synthetic placeholders, never real floors.
+    """
+    scope = ("Different row sets from the batch-C deciding populations; context only. "
+             "Not a floor on dev+clean80 or clean80, not used in any decision, "
+             "threshold, bootstrap or network-minus-floor comparison.")
+    if mock:
+        return {c: dict(scope=scope, synthetic=True, source=None, context={
+            "note": "Synthetic context placeholder; no real floor values loaded."})
+                for c in WITHIN_D_CONTRASTS}
+
+    def committed(relative):
+        data = (CONTEXT_ROOT / relative).read_bytes()
+        saved = subprocess.run(
+            ["git", "-C", str(CONTEXT_ROOT), "show", "HEAD:" + relative.as_posix()],
+            check=True, capture_output=True).stdout
+        if data != saved:
+            raise ValueError(f"uncommitted within-D context input: {relative}")
+        return data
+
+    pinpath = CONTEXT_DIR / "pins_stage6.sha256"
+    pinbytes = committed(pinpath)
+    pins = pinbytes.decode().splitlines()
+    result = {}
+    for c in WITHIN_D_CONTRASTS:
+        name = c + "_withinD.json"
+        relative = CONTEXT_DIR / name
+        data = committed(relative)
+        digest = hashlib.sha256(data).hexdigest()
+        if digest + "  " + name not in pins:
+            raise ValueError(f"within-D context missing committed stage-6 pin: {name}")
+        result[c] = dict(scope=scope, synthetic=False, source=dict(
+            path=str((CONTEXT_ROOT / relative).resolve()), sha256=digest,
+            pinfile=str((CONTEXT_ROOT / pinpath).resolve()),
+            pinfile_sha256=hashlib.sha256(pinbytes).hexdigest()),
+            context=json.loads(data))
+    return result
+
