+def _exclusive_json(path, value):
+    """Durable create-only JSON; failures never remove a possibly consumed claim."""
+    path = pathlib.Path(path)
+    with path.open("x") as f:
+        json.dump(value, f, indent=1,
+                  default=lambda o: o.item() if isinstance(o, np.generic) else str(o))
+        f.write("\n")
+        f.flush()
+        os.fsync(f.fileno())
+    fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def _claim_read(pair, out, mock, c_results, ab1_results, once_root=ONCE_ROOT):
+    """Called before any archive loader. Canonical per-pair claim survives failure.
+
+    Production CLI cannot redirect once_root. A new output path cannot bypass it.
+    Mock callers do not claim production and still cannot overwrite output.
+    """
+    out = pathlib.Path(out).absolute()
+    if os.path.lexists(out):
+        raise FileExistsError(f"output already exists (never overwritten): {out}")
+    if not out.parent.is_dir():
+        raise FileNotFoundError(f"output directory does not exist: {out.parent}")
+    if mock:
+        return None
+    root = pathlib.Path(once_root)
+    root.mkdir(parents=True, exist_ok=True)
+    claim = root / f"{pair}.claim.json"
+    _exclusive_json(claim, dict(
+        status="claimed_before_score_access", pair=pair,
+        claimed_utc=datetime.now(timezone.utc).isoformat(), pid=os.getpid(),
+        output=str(out), reader_sha256=hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),
+        c_results=str(pathlib.Path(c_results).resolve()),
+        ab1_results=str(pathlib.Path(ab1_results).resolve()),
+        c_overlay=C_OVERLAY,
+        failure_policy="Claim is permanent even after failure; no automatic retry or deletion."))
+    return claim
+
