+def _validate_native_archive(tar, arm, seed, eval_manifest, eval_sha):
+    """Check task identity and lossless row mapping before the legacy dict(zip).
+
+    Uses only the pinned evaluation manifest; never infers expected row order from
+    candidate output. Returns a rejection reason, or None for valid metadata.
+    """
+    tar = pathlib.Path(tar)
+    sidecar = tar.with_name(tar.name + ".sha256")
+    if not tar.exists() or not sidecar.exists():
+        return "missing"
+    tokens = sidecar.read_text().split()
+    if not tokens or hashlib.sha256(tar.read_bytes()).hexdigest() != tokens[0]:
+        return "sha256 mismatch"
+    manifest_bytes = pathlib.Path(eval_manifest).read_bytes()
+    if hashlib.sha256(manifest_bytes).hexdigest() != eval_sha:
+        raise ValueError("pinned eval manifest hash mismatch")
+    expected = [r["id"] for r in csv.DictReader(io.StringIO(manifest_bytes.decode()))]
+    if len(expected) != len(set(expected)):
+        raise ValueError("pinned eval manifest has duplicate IDs")
+    task = tar.name[:-4]
+    try:
+        with tarfile.open(tar) as archive:
+            wanted = (f"{task}/task.env", f"{task}/scores_eval.npz")
+            for name in wanted:
+                members = [m for m in archive.getmembers() if m.name == name]
+                if len(members) != 1 or not members[0].isfile():
+                    return f"native metadata member missing, duplicated or non-file: {name}"
+            env = archive.extractfile(wanted[0]).read().decode()
+            # The registered launchers write one unquoted assignment per line.
+            fields = {}
+            for line in env.splitlines():
+                key, sep, value = line.strip().partition("=")
+                if key in ("TASK", "ARM", "SEED") and sep:
+                    if key in fields:
+                        return f"task.env duplicate {key}"
+                    fields[key] = value
+            if fields.get("TASK") != task or fields.get("ARM") != arm or fields.get("SEED") != str(seed):
+                return "task.env exact task/arm/seed mismatch"
+            with np.load(io.BytesIO(archive.extractfile(wanted[1]).read()), allow_pickle=False) as z:
+                ids, logits = z["id"], z["logit"]
+                if ids.ndim != 1 or logits.ndim != 1 or len(ids) != len(logits):
+                    return "eval id/logit shape or length mismatch"
+                actual = [str(x) for x in ids]
+                if len(actual) != len(set(actual)):
+                    return "duplicate eval score IDs"
+                if actual != expected:
+                    return "eval score IDs/order differ from pinned manifest"
+                if not np.isfinite(logits.astype(float)).all():
+                    return "non-finite eval logits"
+    except (KeyError, ValueError, UnicodeError, tarfile.TarError) as exc:
+        return f"native metadata invalid: {type(exc).__name__}"
+    return None
+
